# ─────────────────────────────────────────────────────────────
# Courts — Environment Variables
# Copy this file to `.env.local` and fill in your Supabase values.
# (On Vercel, add these two under Project Settings → Environment Variables.)
# ─────────────────────────────────────────────────────────────

# Supabase project URL. Find it in your Supabase dashboard:
#   Project Settings → API → "Project URL"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"

# Supabase anon (public) key — safe to expose in the browser.
#   Project Settings → API → "Project API keys" → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# The email that gets ADMIN access (admin dashboard, mark no-show/completed,
# analytics, clear-all). Register in the app with this exact email to be admin.
NEXT_PUBLIC_ADMIN_EMAIL="applicationdevelopmentincloud@gmail.com"
